{
  "env": {
    "browser": true,
    "node": true,
    "es2020": true
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "caughtErrors": "none" }],
    "no-var": "warn",
    "prefer-const": "warn",
    "eqeqeq": ["warn", "always"]
  },
  "ignorePatterns": [
    "public/",
    "node_modules/",
    "resources/"
  ]
}
